// Fase 1 do backend — ver docs/PLANO_BACKEND_FASE1.md.
// Identidade (User/Session/Account/Verification) segue o formato exigido pelo
// adapter Prisma do Better Auth. Tenancy e cadastros base são modelagem nossa.
//
// Identificadores em ASCII (Prisma não aceita acento em nomes de enum);
// os rótulos originais ficam preservados via @map, que é o valor gravado no banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Identidade (Better Auth)
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // plataforma
  role               String? // "superadmin" quando aplicável (plugin admin do Better Auth)
  banned             Boolean   @default(false)
  banReason          String?
  banExpires         DateTime?
  mustChangePassword Boolean   @default(true)
  ativo              Boolean   @default(true)

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ============================================================
// Tenancy
// ============================================================

enum ContaStatus {
  ATIVA
  SUSPENSA
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Conta {
  id          String      @id @default(cuid())
  nome        String
  razaoSocial String?
  cnpj        String?     @unique
  status      ContaStatus @default(ATIVA)
  ativo       Boolean     @default(true)

  memberships   Membership[]
  propriedades  Propriedade[]
  culturas      Cultura[]
  safras        Safra[]
  socios               Socio[]
  bensDireitos         BemDireito[]
  garantias            Garantia[]
  capex                Capex[]
  perfilGrupoEconomico PerfilGrupoEconomico?
  balancos             BalancoPatrimonial[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@map("contas")
}

model Membership {
  id      String         @id @default(cuid())
  userId  String
  contaId String
  role    MembershipRole @default(MEMBER)
  ativo   Boolean        @default(true)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contaId])
  @@index([contaId])
  @@map("memberships")
}

model Propriedade {
  id                String  @id @default(cuid())
  contaId           String
  nome              String
  cidade            String?
  estado            String? // UF, 2 chars
  areaTotalHectares Float?
  ativo             Boolean @default(true)

  conta               Conta                  @relation(fields: [contaId], references: [id], onDelete: Cascade)
  suppliers           Supplier[]
  quadroSafras        QuadroSafra[]
  contratosBancarios  ContratoBancario[]
  aquisicoes          Aquisicao[]
  arrendamentos       ContratoArrendamento[]
  contratosComerciais ContratoComercial[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([contaId])
  @@index([contaId, ativo])
  @@map("propriedades")
}

// ============================================================
// Cadastros base
// ============================================================

model Cultura {
  id      String  @id @default(cuid())
  contaId String? // null = catálogo global seedado; preenchido = cultura própria da conta
  nome    String
  ativo   Boolean @default(true)

  conta Conta? @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([contaId, nome])
  @@map("culturas")
}

model Safra {
  id         String    @id @default(cuid())
  contaId    String
  anoSafra   String // "2026/2027"
  dataInicio DateTime?
  dataFim    DateTime?
  atual      Boolean   @default(false)
  ativo      Boolean   @default(true)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([contaId, anoSafra])
  @@index([contaId, ativo])
  @@map("safras")
}

// Registro de planejamento por cultura × ano-safra (Quadro de Safra + Resumo).
// `cultura`/`anoSafra` seguem string livre — mesmo padrão adotado em Supplier,
// consistente com src/types.ts; normalização via FK para Cultura/Safra fica
// para uma limpeza futura, fora do escopo desta fase.
model QuadroSafra {
  id                    String   @id @default(cuid())
  propriedadeId         String
  cultura               String
  anoSafra              String // "2026/2027"
  hectares              Float
  haPropria             Float
  haArrendada           Float
  rendimento            Decimal  @db.Decimal(12, 4) // unidade/ha
  unidadeProducao       String // "sc", "kg", "@", "ton", "m³"
  precoMedio            Decimal  @db.Decimal(18, 2)
  despesa               Decimal  @db.Decimal(18, 2)
  producaoFixadaPercent Decimal? @db.Decimal(5, 2)
  ativo                 Boolean  @default(true)

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([propriedadeId, cultura, anoSafra])
  @@index([propriedadeId, ativo])
  @@map("quadro_safra")
}

enum EstadoCivil {
  SOLTEIRO   @map("Solteiro")
  CASADO     @map("Casado")
  VIUVO      @map("Viúvo")
  DIVORCIADO @map("Divorciado")
  SEPARADO   @map("Separado")
}

model Socio {
  id             String       @id @default(cuid())
  contaId        String // participação societária é do grupo econômico, não da fazenda
  nome           String
  cpf            String
  participacao   Decimal      @db.Decimal(5, 2) // 0-100
  estadoCivil    EstadoCivil?
  telefone       String?
  email          String?
  nacionalidade  String?
  dataNascimento DateTime?
  ativo          Boolean      @default(true)

  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  bensDireitos BemDireito[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([contaId, cpf])
  @@index([contaId, ativo])
  @@map("socios")
}

// Sub-abas de Cadastro Mestre (Bens e Direitos, Garantias, CAPEX, Grupo
// Econômico) — a doc de engenharia reversa do AgroFlow só cita os nomes
// dessas abas, sem spec de campos, com uma exceção: Bens e Direitos teve seu
// formulário real ("Novo Bem / Direito") fotografado pelo usuário em
// 05/08/2026, então o conjunto de campos abaixo é réplica confirmada da tela
// original — não "campos estimados" nem design próprio (diferente de
// Garantias/CAPEX/Grupo Econômico, que seguem sem spec). Grupo IRPF segue a
// taxonomia padrão da Declaração de Bens e Direitos da Receita Federal;
// Código/Tipo é texto livre (não um enum fechado) porque não temos a tabela
// oficial completa de códigos por grupo confirmada — só o exemplo do print
// ("18 — Imóvel Rural") — e inventar códigos de IRPF é arriscado demais para
// um dado que pode alimentar declaração fiscal real. Todas penduram em Conta
// (grupo econômico), mesmo raciocínio de Socio; Bens e Direitos também aceita
// vínculo opcional a um Socio específico (Sócio Titular).

enum GrupoIrpfBem {
  BENS_IMOVEIS              @map("Bens Imóveis")
  BENS_MOVEIS                @map("Bens Móveis")
  PARTICIPACOES_SOCIETARIAS @map("Participações Societárias")
  APLICACOES_INVESTIMENTOS  @map("Aplicações e Investimentos")
  DEPOSITOS_POUPANCA         @map("Depósitos à Vista e Poupança")
  CREDITOS_DIREITOS          @map("Créditos e Outros Direitos")
  CRIPTOATIVOS               @map("Criptoativos")
  OUTROS_BENS                @map("Outros Bens e Direitos")
}

enum LiquidezBem {
  ALTA  @map("Alta")
  MEDIA @map("Média")
  BAIXA @map("Baixa")
}

// valorGarantiaEstimado não é persistido — computado ao vivo
// (valorMercadoEstimado * ltv / 100) quando elegivelGarantia, mesmo critério
// de src/lib/indicadores.ts (índice derivado nunca é número solto no banco).
model BemDireito {
  id                   String       @id @default(cuid())
  contaId              String
  socioId              String? // opcional — vazio = "Grupo (sem sócio específico)"
  grupoIrpf            GrupoIrpfBem
  codigoTipo           String // ex: "18 — Imóvel Rural" (texto livre, ver nota acima)
  descricao            String
  valorDeclaradoIrpf   Decimal?     @db.Decimal(18, 2)
  valorMercadoEstimado Decimal?     @db.Decimal(18, 2)
  dataAquisicao        DateTime?
  valorAquisicao       Decimal?     @db.Decimal(18, 2)
  liquidez             LiquidezBem  @default(BAIXA)
  ltv                  Decimal?     @db.Decimal(5, 2) // 0-100
  elegivelGarantia     Boolean      @default(false)
  geraFluxoCaixa       Boolean      @default(false)
  observacoes          String?
  ativo                Boolean      @default(true)

  conta Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)
  socio Socio? @relation(fields: [socioId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([contaId, ativo])
  @@index([socioId])
  @@map("bens_direitos")
}

// Garantias/CAPEX/Grupo Econômico (Garantia, Capex, PerfilGrupoEconomico) tiveram seus
// formulários reais fotografados pelo usuário em 05/08/2026 — mesmo critério de Bens e
// Direitos: réplica confirmada, não mais "design próprio". tipoAtivo/tipoGarantia
// (Garantia) e tipo/status (Capex) ficam como texto livre em vez de enum fechado: os
// prints mostram os selects fechados, só alguns valores são confirmados ("Máquina /
// Equipamento", "Reforma / Modernização", "Planejado") — a lista completa de opções
// ainda não foi levantada pelo usuário (ver docs/PLANO_BACKEND_FASE1.md, Fase 6). Manter
// como texto livre evita pagar o custo de uma segunda migration quando a lista real
// chegar — só troca o array de opções do <Select> no componente.
model Garantia {
  id             String   @id @default(cuid())
  contaId        String
  tipoAtivo      String
  tipoGarantia   String
  descricao      String // "Descrição do Ativo"
  bancoVinculado String?
  numeroOperacao String?
  valor          Decimal  @db.Decimal(18, 2)
  moeda          Currency @default(BRL) // reaproveita o enum já usado em ContratoBancario.moeda
  observacoes    String?
  ativo          Boolean  @default(true)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([contaId, ativo])
  @@map("garantias")
}

model Capex {
  id                      String   @id @default(cuid())
  contaId                 String
  descricao               String
  tipo                    String
  ano                     Int
  valorPlanejado          Decimal  @db.Decimal(18, 2)
  valorExecutado          Decimal  @default(0) @db.Decimal(18, 2)
  percentualFinanciamento Decimal? @db.Decimal(5, 2) // 0-100
  status                  String   @default("Planejado")
  observacoes             String?
  ativo                   Boolean  @default(true)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([contaId, ativo])
  @@index([contaId, ano])
  @@map("capex")
}

// Perfil do grupo econômico (aba "Grupo Econômico") + histórico narrativo (aba
// "Histórico do Grupo") — 1:1 com Conta. Substitui o antigo EmpresaGrupo (lista de
// empresas Controladora/Controlada/Coligada), que não existe na tela real — removido.
// Não tem nome/razaoSocial/cnpj: esses já são cadastrados pelo Admin Master na criação
// da conta (Conta.nome/razaoSocial/cnpj, src/server/contas.ts) — a aba "Grupo Econômico"
// lê e exibe esses campos direto de Conta (via requireContext(), read-only aqui) em vez
// de duplicá-los numa segunda tabela que nasceria vazia. Este model guarda só os campos
// extras que o próprio usuário da conta preenche por cima disso (contato, atividade,
// fundação, sede, consultor). "Histórico do Grupo" resolve a pendência que existia (audit
// log automático vs. timeline manual): não é nenhum dos dois, é um único campo de texto
// livre, usado na Apresentação do Grupo (Slide 2) e no Parecer Executivo.
model PerfilGrupoEconomico {
  id                   String    @id @default(cuid())
  contaId              String    @unique
  email                String?
  telefone             String?
  atividadePrincipal   String?
  fundacao             DateTime?
  sede                 String?
  consultorResponsavel String?
  historico            String?

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("perfil_grupo_economico")
}

// ============================================================
// Fornecedores
// ============================================================

enum Category {
  FERTILIZANTES
  DEFENSIVOS
  SEMENTES
  MAQUINARIOS   @map("MAQUINÁRIOS")
  COMBUSTIVEL   @map("COMBUSTÍVEL")
  SERVICOS      @map("SERVIÇOS")
  OUTROS
}

enum Currency {
  BRL
  USD
}

enum SupplierStatus {
  PENDENTE
  PAGO
  VENCIDO
}

// Formulário "Cadastrar Fornecedor" fotografado pelo usuário em 05/08/2026 — réplica
// confirmada; substitui os campos cnpj_cpf/contato_nome/contato_telefone/contato_email da
// doc de engenharia reversa ("Entidade: FORNECEDOR (estimado)", nunca confirmados por
// print), removidos por não existirem na tela real.
model Supplier {
  id              String         @id @default(cuid())
  propriedadeId   String
  nome            String
  categoria       Category
  cultura         String?
  safra           String?
  dividaTotal     Decimal        @db.Decimal(18, 2)
  moeda           Currency
  vencimento      DateTime
  observacoes     String?
  status          SupplierStatus @default(PENDENTE)
  imageUrl        String?
  comprovanteUrl  String?
  ativo           Boolean        @default(true)

  propriedade Propriedade        @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  compras     CompraFornecedor[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@map("suppliers")
}

model CompraFornecedor {
  id                String   @id @default(cuid())
  supplierId        String
  data              DateTime
  valor             Decimal  @db.Decimal(18, 2)
  descricao         String
  culturaReferencia String?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  createdById String?

  @@index([supplierId])
  @@map("compras_fornecedor")
}

// ============================================================
// Bancos e Financiamentos
// ============================================================

enum TipoContratoBancario {
  CUSTEO
  CPR
  FINANCIAMENTO
  CREDIARIO
}

enum TipoTaxaBancaria {
  CDI
  PRIME
  PRE       @map("PRÉ")
  FLUTUANTE
}

enum SistemaAmortizacao {
  SAC
  PRICE
  BULLET
}

enum PeriodicidadePagamento {
  MENSAL     @map("Mensal")
  TRIMESTRAL @map("Trimestral")
  SEMESTRAL  @map("Semestral")
  ANUAL      @map("Anual")
}

enum FinalidadeContrato {
  CUSTEIO
  INVESTIMENTO
  CAPITAL_GIRO
}

model ContratoBancario {
  id                 String                 @id @default(cuid())
  propriedadeId      String
  banco              String
  tipoContrato       TipoContratoBancario
  saldoInicial       Decimal                @db.Decimal(18, 2)
  saldoAtual         Decimal                @db.Decimal(18, 2)
  taxaJuros          Decimal                @db.Decimal(8, 4) // % a.a.
  tipoTaxa           TipoTaxaBancaria
  taxaAdicional      Decimal?               @db.Decimal(8, 4) // % a.a., só quando tipoTaxa = CDI
  dataContratacao    DateTime
  dataVencimento     DateTime
  sistemaAmortizacao SistemaAmortizacao
  periodicidade      PeriodicidadePagamento
  finalidade         FinalidadeContrato
  moeda              Currency
  observacoes        String?
  ativo              Boolean                @default(true)

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  parcelas    Parcela[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@map("contratos_bancarios")
}

// Cronograma auto-gerado (src/lib/amortizacao.ts) a cada criação/edição do
// contrato — regra da engenharia reversa do AgroFlow. Sem UI de baixa de
// parcela ainda (sem spec), então é recriado do zero a cada save.
model Parcela {
  id             String   @id @default(cuid())
  contratoId     String
  numero         Int
  dataPagamento  DateTime
  valorPrincipal Decimal  @db.Decimal(18, 2)
  valorJuros     Decimal  @db.Decimal(18, 2)
  valorTotal     Decimal  @db.Decimal(18, 2)
  saldoDevedor   Decimal  @db.Decimal(18, 2) // saldo após o pagamento desta parcela
  pago           Boolean  @default(false)

  contrato ContratoBancario @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, numero])
  @@index([contratoId])
  @@map("parcelas")
}

// ============================================================
// Aquisição de Fazendas
// ============================================================

// `valorTotalFluxo` é um total resumo (sem detalhamento em parcelas na UI/
// spec atual) — nada de ParcelaAquisicao inventado sem fonte.
model Aquisicao {
  id               String    @id @default(cuid())
  propriedadeId    String
  nomeFazenda      String
  localizacao      String
  areaHectares     Float
  valorTotal       Decimal   @db.Decimal(18, 2)
  dataAquisicao    DateTime
  dataOcupacao     DateTime?
  culturaPrincipal String?
  safraInicio      String // "2026/2027"
  safraFim         String
  valorTotalFluxo  Decimal   @db.Decimal(18, 2)
  totalSacas       Float
  ativo            Boolean   @default(true)

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@map("aquisicoes")
}

// ============================================================
// Arrendamentos
// ============================================================

enum PeriodicidadeArrendamento {
  ANUAL     @map("Anual")
  MENSAL    @map("Mensal")
  POR_SAFRA @map("Por Safra")
}

enum StatusArrendamento {
  ATIVO
  ENCERRADO
}

model ContratoArrendamento {
  id                  String                    @id @default(cuid())
  propriedadeId       String
  nomePropriedade     String
  localizacao         String
  proprietarioNome    String
  proprietarioCpfCnpj String
  areaHectares        Float
  culturaPrincipal    String
  custoAnualHectare   Decimal                   @db.Decimal(18, 2)
  sacasPorHectare     Decimal?                  @db.Decimal(12, 4)
  dataInicio          DateTime
  dataFim             DateTime
  periodicidade       PeriodicidadeArrendamento
  renovavel           Boolean                   @default(true)
  status              StatusArrendamento        @default(ATIVO)
  safraInicio         String
  safraFim            String
  observacoes         String?
  ativo               Boolean                   @default(true)

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@map("contratos_arrendamento")
}

// ============================================================
// Comercialização (Futuros/Hedge)
// ============================================================

enum TipoContratoComercial {
  FUTURO
  VENDA_A_TERMO
  HEDGE_CALL
  HEDGE_PUT
}

enum StatusContratoComercial {
  ATIVO
  LIQUIDADO
  CANCELADO
}

model ContratoComercial {
  id             String                  @id @default(cuid())
  propriedadeId  String
  cultura        String
  safra          String
  quantidadeSc   Float
  precoFixado    Decimal                 @db.Decimal(18, 2)
  tipoContrato   TipoContratoComercial
  dataContrato   DateTime
  dataVencimento DateTime
  status         StatusContratoComercial @default(ATIVO)
  compradorNome  String?
  observacoes    String?
  ativo          Boolean                 @default(true)

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@map("contratos_comerciais")
}

// ============================================================
// Análise Financeira — Balanço consolidado do grupo (Conta)
// ============================================================

// Indicadores são SEMPRE computados ao vivo a partir destes 6 campos
// (src/lib/indicadores.ts) — nunca persistidos como número solto. Indicadores
// que exigiriam contas mais finas (caixa, estoques, EBITDA...) não existentes
// aqui ficam explicitamente "dados insuficientes" na UI, nunca inventados.
model BalancoPatrimonial {
  id                   String  @id @default(cuid())
  contaId              String
  safra                String // "2026/2027"
  ativoCirculante      Decimal @db.Decimal(18, 2)
  ativoNaoCirculante   Decimal @db.Decimal(18, 2)
  passivoCirculante    Decimal @db.Decimal(18, 2)
  passivoNaoCirculante Decimal @db.Decimal(18, 2)
  capitalReservas      Decimal @db.Decimal(18, 2)
  resultadoSafra       Decimal @db.Decimal(18, 2)
  ativo                Boolean @default(true)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([contaId, safra])
  @@index([contaId, ativo])
  @@map("balancos_patrimoniais")
}

// ============================================================
// Cotações de Mercado — dado global, sem tenant (mesmo preço pra todo mundo).
// Ingestão real: AwesomeAPI (câmbio) + Yahoo Finance (futuros de commodities),
// ambas sem chave — ver src/lib/market-data.ts.
// ============================================================

enum Bolsa {
  CBOT
  CME
  ICE
  B3
  PTAX
}

model Cotacao {
  id                 String   @id @default(cuid())
  commodity          String   @unique
  bolsa              Bolsa
  ticker             String
  precoUsd           Decimal? @db.Decimal(18, 4)
  precoBrl           Decimal  @db.Decimal(18, 4)
  unidade            String
  variacaoPercentual Decimal  @db.Decimal(8, 4)
  maxima             Decimal  @db.Decimal(18, 4)
  minima             Decimal  @db.Decimal(18, 4)
  volume             BigInt   @default(0)
  precoDefinidoSafra Decimal? @db.Decimal(18, 4) // preço que o usuário "trava" como referência da safra
  atualizadoEm       DateTime @default(now())

  @@map("cotacoes")
}
