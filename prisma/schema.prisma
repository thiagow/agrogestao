// Fase 1 do backend — ver docs/PLANO_BACKEND_FASE1.md.
// Identidade (User/Session/Account/Verification) segue o formato exigido pelo
// adapter Prisma do Better Auth. Tenancy e cadastros base são modelagem nossa.
//
// Identificadores em ASCII (Prisma não aceita acento em nomes de enum);
// os rótulos originais ficam preservados via @map, que é o valor gravado no banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Banco vazio e descartável que o Prisma usa para gerar migrations
  // (`migrate dev`) e comparar histórico com produção. Ver .env.example.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================================
// Identidade (Better Auth)
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // plataforma
  role               String? // "superadmin" quando aplicável (plugin admin do Better Auth)
  banned             Boolean   @default(false)
  banReason          String?
  banExpires         DateTime?
  mustChangePassword Boolean   @default(true)
  ativo              Boolean   @default(true)

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ============================================================
// Tenancy
// ============================================================

enum ContaStatus {
  ATIVA
  SUSPENSA
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Conta {
  id          String      @id @default(cuid())
  nome        String
  razaoSocial String?
  cnpj        String?     @unique
  status      ContaStatus @default(ATIVA)
  ativo       Boolean     @default(true)

  memberships          Membership[]
  propriedades         Propriedade[]
  culturas             Cultura[]
  safras               Safra[]
  socios               Socio[]
  bensDireitos         BemDireito[]
  garantias            Garantia[]
  dividasPf            DividaPf[]
  capex                Capex[]
  perfilGrupoEconomico PerfilGrupoEconomico?
  balancos             BalancoPatrimonial[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@map("contas")
}

model Membership {
  id      String         @id @default(cuid())
  userId  String
  contaId String
  role    MembershipRole @default(MEMBER)
  ativo   Boolean        @default(true)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, contaId])
  @@index([contaId])
  @@map("memberships")
}

model Propriedade {
  id                String  @id @default(cuid())
  contaId           String
  nome              String
  cidade            String?
  estado            String? // UF, 2 chars
  areaTotalHectares Float?
  ativo             Boolean @default(true)

  conta               Conta                  @relation(fields: [contaId], references: [id], onDelete: Cascade)
  suppliers           Supplier[]
  quadroSafras        QuadroSafra[]
  contratosBancarios  ContratoBancario[]
  aquisicoes          Aquisicao[]
  arrendamentos       ContratoArrendamento[]
  contratosComerciais ContratoComercial[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([contaId])
  @@index([contaId, ativo])
  @@map("propriedades")
}

// ============================================================
// Cadastros base
// ============================================================

model Cultura {
  id            String  @id @default(cuid())
  contaId       String? // null = catálogo global seedado; preenchido = cultura própria da conta
  nome          String
  unidadeMedida String  @default("sc") // "sc", "kg", "@", "t", "m³"
  ativo         Boolean @default(true)

  conta              Conta?                 @relation(fields: [contaId], references: [id], onDelete: Cascade)
  contratosBancarios ContratoBancario[]
  aquisicoes         Aquisicao[]
  arrendamentos      ContratoArrendamento[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([contaId, nome])
  @@map("culturas")
}

model Safra {
  id         String    @id @default(cuid())
  contaId    String
  anoSafra   String // "2026/2027"
  dataInicio DateTime?
  dataFim    DateTime?
  atual      Boolean   @default(false)
  ativo      Boolean   @default(true)

  conta              Conta              @relation(fields: [contaId], references: [id], onDelete: Cascade)
  contratosBancarios ContratoBancario[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  @@unique([contaId, anoSafra])
  @@index([contaId, ativo])
  @@map("safras")
}

// Registro de planejamento por cultura × ano-safra (Quadro de Safra + Resumo).
// `cultura`/`anoSafra` seguem string livre — mesmo padrão adotado em Supplier,
// consistente com src/types.ts; normalização via FK para Cultura/Safra fica
// para uma limpeza futura, fora do escopo desta fase.
model QuadroSafra {
  id                    String   @id @default(cuid())
  propriedadeId         String
  cultura               String
  anoSafra              String // "2026/2027"
  hectares              Float
  haPropria             Float
  haArrendada           Float
  rendimento            Decimal  @db.Decimal(12, 4) // unidade/ha
  unidadeProducao       String // "sc", "kg", "@", "ton", "m³"
  precoMedio            Decimal  @db.Decimal(18, 2)
  custoProducao         Decimal  @db.Decimal(12, 2) // R$ por hectare — despesa total é derivada (custoProducao * hectares)
  producaoFixadaPercent Decimal? @db.Decimal(5, 2)
  ativo                 Boolean  @default(true)

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([propriedadeId, cultura, anoSafra])
  @@index([propriedadeId, ativo])
  @@map("quadro_safra")
}

enum EstadoCivil {
  SOLTEIRO   @map("Solteiro")
  CASADO     @map("Casado")
  VIUVO      @map("Viúvo")
  DIVORCIADO @map("Divorciado")
  SEPARADO   @map("Separado")
}

enum TipoPessoa {
  PF
  PJ
}

// Refatoração "Sócios e Empresas" (20/08/2026): Socio passou a representar tanto
// integrantes PF quanto empresas PJ do grupo — o mesmo model, discriminado por
// tipoPessoa. Campos existentes (nome, cpf, nacionalidade, dataNascimento) foram
// mantidos como estão (3 sócios reais em produção) e ganharam um segundo
// significado condicional na UI quando tipoPessoa=PJ, em vez de renomeados:
// nome -> "Razão Social", nacionalidade -> "Cidade/UF", dataNascimento -> "Data de
// Fundação". cpf virou opcional (só PF) e cnpj é novo (só PJ). cargoOuAtividade é
// um campo novo único que também dobra de rótulo ("Cargo" no PF, "Atividade
// Principal" na PJ). estadoCivil só se aplica a PF. `participacao` continua sendo
// a % do integrante NO GRUPO ECONÔMICO (usada por src/lib/patrimonio.ts) — a nova
// ParticipacaoSocietaria abaixo é um conceito separado (% de um PF numa PJ
// específica, cap table da empresa), os dois nunca se somam nem se substituem.
model Socio {
  id               String       @id @default(cuid())
  contaId          String // participação societária é do grupo econômico, não da fazenda
  tipoPessoa       TipoPessoa   @default(PF)
  nome             String // "Nome Completo" (PF) / "Razão Social" (PJ)
  cpf              String? // só PF
  cnpj             String? // só PJ
  cargoOuAtividade String? // "Cargo" (PF) / "Atividade Principal" (PJ)
  participacao     Decimal      @db.Decimal(5, 2) // 0-100, % no grupo econômico
  estadoCivil      EstadoCivil? // só PF
  telefone         String?
  email            String?
  nacionalidade    String? // "Nacionalidade" (PF) / "Cidade/UF" (PJ)
  dataNascimento   DateTime? // "Data de Nascimento" (PF) / "Data de Fundação" (PJ)
  ativo            Boolean      @default(true)

  conta        Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  bensDireitos BemDireito[]

  // Cap table: quando este Socio é uma PJ, participacoesNaEmpresa lista os PF donos
  // dela e o % de cada um. Quando é PF, participacoesComoDono lista as PJ das quais
  // é dono e o % que tem em cada uma. As duas pontas da mesma relação.
  participacoesComoDono  ParticipacaoSocietaria[] @relation("Dono")
  participacoesNaEmpresa ParticipacaoSocietaria[] @relation("Empresa")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([contaId, cpf])
  @@unique([contaId, cnpj])
  @@index([contaId, ativo])
  @@map("socios")
}

// Cap table de uma PJ do grupo — cada linha é "este Socio PF possui X% desta
// Socio PJ". Validação de soma <= 100% por socioPjId feita em src/server/socios.ts
// (não dá pra validar agregação no schema).
model ParticipacaoSocietaria {
  id         String  @id @default(cuid())
  socioPjId  String // a empresa
  socioPfId  String // o dono (pessoa física)
  percentual Decimal @db.Decimal(5, 2) // 0-100

  socioPj Socio @relation("Empresa", fields: [socioPjId], references: [id], onDelete: Cascade)
  socioPf Socio @relation("Dono", fields: [socioPfId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([socioPjId, socioPfId])
  @@index([socioPjId])
  @@index([socioPfId])
  @@map("participacoes_societarias")
}

// Sub-abas de Cadastro Mestre (Bens e Direitos, Garantias, CAPEX, Grupo
// Econômico) — a doc de engenharia reversa do AgroFlow só cita os nomes
// dessas abas, sem spec de campos, com uma exceção: Bens e Direitos teve seu
// formulário real ("Novo Bem / Direito") fotografado pelo usuário em
// 05/08/2026, então o conjunto de campos abaixo é réplica confirmada da tela
// original — não "campos estimados" nem design próprio (diferente de
// Garantias/CAPEX/Grupo Econômico, que seguem sem spec). Grupo IRPF segue a
// taxonomia padrão da Declaração de Bens e Direitos da Receita Federal;
// Código/Tipo é texto livre (não um enum fechado) porque não temos a tabela
// oficial completa de códigos por grupo confirmada — só o exemplo do print
// ("18 — Imóvel Rural") — e inventar códigos de IRPF é arriscado demais para
// um dado que pode alimentar declaração fiscal real. Todas penduram em Conta
// (grupo econômico), mesmo raciocínio de Socio; Bens e Direitos também aceita
// vínculo opcional a um Socio específico (Sócio Titular).

enum GrupoIrpfBem {
  BENS_IMOVEIS              @map("Bens Imóveis")
  BENS_MOVEIS               @map("Bens Móveis")
  PARTICIPACOES_SOCIETARIAS @map("Participações Societárias")
  APLICACOES_INVESTIMENTOS  @map("Aplicações e Investimentos")
  DEPOSITOS_POUPANCA        @map("Depósitos à Vista e Poupança")
  CREDITOS_DIREITOS         @map("Créditos e Outros Direitos")
  CRIPTOATIVOS              @map("Criptoativos")
  OUTROS_BENS               @map("Outros Bens e Direitos")
  // Adicionados em 20/08/2026 — cada um ganha um grid/modal próprio (DetalheImovelRural/
  // DetalheImovelUrbano abaixo) em vez do formulário genérico de Bens e Direitos.
  IMOVEIS_RURAIS_ANEXO_A    @map("Imóveis Rurais - ANEXO A")
  IMOVEIS_URBANOS_ANEXO_B   @map("Imóveis Urbanos - ANEXO B")
}

enum LiquidezBem {
  ALTA  @map("Alta")
  MEDIA @map("Média")
  BAIXA @map("Baixa")
}

// valorGarantiaEstimado não é persistido — computado ao vivo
// (valorMercadoEstimado * ltv / 100) quando elegivelGarantia, mesmo critério
// de src/lib/indicadores.ts (índice derivado nunca é número solto no banco).
model BemDireito {
  id                   String       @id @default(cuid())
  contaId              String
  socioId              String? // opcional — vazio = "Grupo (sem sócio específico)"
  grupoIrpf            GrupoIrpfBem
  codigoTipo           String // ex: "18 — Imóvel Rural" (texto livre, ver nota acima)
  descricao            String
  valorDeclaradoIrpf   Decimal?     @db.Decimal(18, 2)
  valorMercadoEstimado Decimal?     @db.Decimal(18, 2)
  dataAquisicao        DateTime?
  valorAquisicao       Decimal?     @db.Decimal(18, 2)
  liquidez             LiquidezBem  @default(BAIXA)
  ltv                  Decimal?     @db.Decimal(5, 2) // 0-100
  elegivelGarantia     Boolean      @default(false)
  geraFluxoCaixa       Boolean      @default(false)
  observacoes          String?
  ativo                Boolean      @default(true)

  conta Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)
  socio Socio? @relation(fields: [socioId], references: [id], onDelete: SetNull)

  detalheImovelRural  DetalheImovelRural?
  detalheImovelUrbano DetalheImovelUrbano?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([contaId, ativo])
  @@index([socioId])
  @@map("bens_direitos")
}

// Detalhe 1:1 de um BemDireito com grupoIrpf=IMOVEIS_RURAIS_ANEXO_A — mesmo padrão de
// Aquisicao/ParcelaAquisicao (entidade-mãe genérica + tabela de detalhe específica).
// "Valor de Mercado Total (R$)" da spec NÃO é uma coluna aqui: é
// BemDireito.valorMercadoEstimado (= areaHa × valorMercadoHa, calculado ao vivo no
// client e salvo no pai), assim src/lib/patrimonio.ts soma esses imóveis sem
// nenhuma mudança de fórmula.
model DetalheImovelRural {
  id                            String   @id @default(cuid())
  bemDireitoId                  String   @unique
  denominacaoImovel             String
  municipioUf                   String
  matricula                     String?
  areaHa                        Float
  areaPropriaPlantadaHa         Float?
  areaReservasPastagensOutrosHa Float?
  valorMercadoHa                Decimal? @db.Decimal(18, 2)
  situacaoCredor                String?

  bemDireito BemDireito @relation(fields: [bemDireitoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("detalhes_imovel_rural")
}

// Detalhe 1:1 de um BemDireito com grupoIrpf=IMOVEIS_URBANOS_ANEXO_B. "Valor Atual
// (R$)" da spec é BemDireito.valorMercadoEstimado, mesmo raciocínio do rural acima.
model DetalheImovelUrbano {
  id           String  @id @default(cuid())
  bemDireitoId String  @unique
  descricao    String
  matricula    String?
  cidade       String

  bemDireito BemDireito @relation(fields: [bemDireitoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("detalhes_imovel_urbano")
}

// Garantias/CAPEX/Grupo Econômico (Garantia, Capex, PerfilGrupoEconomico) tiveram seus
// formulários reais fotografados pelo usuário em 05/08/2026 — mesmo critério de Bens e
// Direitos: réplica confirmada, não mais "design próprio". tipoAtivo/tipoGarantia
// (Garantia) e tipo/status (Capex) ficam como texto livre em vez de enum fechado: os
// prints mostram os selects fechados, só alguns valores são confirmados ("Máquina /
// Equipamento", "Reforma / Modernização", "Planejado") — a lista completa de opções
// ainda não foi levantada pelo usuário (ver docs/PLANO_BACKEND_FASE1.md, Fase 6). Manter
// como texto livre evita pagar o custo de uma segunda migration quando a lista real
// chegar — só troca o array de opções do <Select> no componente.
model Garantia {
  id             String   @id @default(cuid())
  contaId        String
  tipoAtivo      String
  tipoGarantia   String
  descricao      String // "Descrição do Ativo"
  bancoVinculado String?
  numeroOperacao String?
  valor          Decimal  @db.Decimal(18, 2)
  moeda          Currency @default(BRL) // reaproveita o enum já usado em ContratoBancario.moeda
  observacoes    String?
  ativo          Boolean  @default(true)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([contaId, ativo])
  @@map("garantias")
}

// Dívidas pessoais dos sócios (financiamento, cartão, empréstimo pessoal, crédito
// rural PF) — sub-aba "Dívidas PF", pareada com Bens e Direitos na mesma tela do
// AgroFlow (print fotografado pelo usuário em 06/08/2026). Explicitamente NÃO
// capturada no Balanço PJ (módulo distinto, já removido — ver nota em Supplier/
// histórico do CLAUDE.md). Sem vínculo a Socio específico: o print não tem campo de
// sócio, mesmo critério de BemDireito sem socioId ("Grupo"). tipoDivida fica como
// texto livre (não enum) — mesmo raciocínio de Garantia.tipoAtivo/tipoGarantia logo
// abaixo: a lista de opções do select (Financiamento/Cartão/Empréstimo Pessoal/
// Crédito Rural PF/Outros) foi inferida do texto da tela, não confirmada como enum
// fechado do AgroFlow original.
model DividaPf {
  id              String    @id @default(cuid())
  contaId         String
  tipoDivida      String
  credor          String?
  saldoDevedor    Decimal   @db.Decimal(18, 2)
  parcelaMensal   Decimal?  @db.Decimal(18, 2)
  vencimentoFinal DateTime?
  observacoes     String?
  ativo           Boolean   @default(true)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([contaId, ativo])
  @@map("dividas_pf")
}

model Capex {
  id                      String   @id @default(cuid())
  contaId                 String
  descricao               String
  tipo                    String
  ano                     Int
  valorPlanejado          Decimal  @db.Decimal(18, 2)
  valorExecutado          Decimal  @default(0) @db.Decimal(18, 2)
  percentualFinanciamento Decimal? @db.Decimal(5, 2) // 0-100
  status                  String   @default("Planejado")
  observacoes             String?
  ativo                   Boolean  @default(true)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([contaId, ativo])
  @@index([contaId, ano])
  @@map("capex")
}

// Perfil do grupo econômico (aba "Grupo Econômico") + histórico narrativo (aba
// "Histórico do Grupo") — 1:1 com Conta. Substitui o antigo EmpresaGrupo (lista de
// empresas Controladora/Controlada/Coligada), que não existe na tela real — removido.
// Não tem nome/razaoSocial/cnpj: esses já são cadastrados pelo Admin Master na criação
// da conta (Conta.nome/razaoSocial/cnpj, src/server/contas.ts) — a aba "Grupo Econômico"
// lê e exibe esses campos direto de Conta (via requireContext(), read-only aqui) em vez
// de duplicá-los numa segunda tabela que nasceria vazia. Este model guarda só os campos
// extras que o próprio usuário da conta preenche por cima disso (contato, atividade,
// fundação, sede, consultor).
//
// "Histórico do Grupo" (20/08/2026): reestruturado de 5 campos-blob soltos para 7
// blocos de questionário, um campo String? por sub-pergunta — mesmo padrão 100%
// tipado do resto do schema, sem JSON solto (tabela estava vazia em produção, sem
// risco de perda de dado na troca). Bloco 6 reaproveita empresasColigadas (já
// existia, mapeia 1:1). Bloco 7 (Missão/Visão/Valores) é novo.
model PerfilGrupoEconomico {
  id                   String    @id @default(cuid())
  contaId              String    @unique
  email                String?
  telefone             String?
  atividadePrincipal   String?
  fundacao             DateTime?
  sede                 String?
  consultorResponsavel String?

  // Bloco 1 — Histórico
  historicoInicio          String?
  historicoHerancaOrigem   String?
  historicoEvolucaoNegocio String?
  historicoGestaoCrises    String?

  // Bloco 2 — Gestão-Sucessão
  gestaoAdministracao            String?
  gestaoParceriasSocios          String?
  gestaoDivisaoCustosFaturamento String?
  gestaoPlanoSucessorioHerdeiros String?

  // Bloco 3 — Modus Operandi (Agricultura)
  agriculturaCustos                    String?
  agriculturaCronogramaPlantioColheita String?
  agriculturaCapacidadeArmazenamento   String?
  agriculturaFornecedoresClientes      String?
  agriculturaModalidadesCompra         String?
  agriculturaExportacao                String?

  // Bloco 4 — Modus Operandi (Pecuária)
  pecuariaCicloProducao               String?
  pecuariaConfinamento                String?
  pecuariaTaxaDesfrutePercent         Decimal? @db.Decimal(5, 2) // 0-100, único campo numérico do bloco
  pecuariaCustosCronogramaCompraAbate String?

  // Bloco 5 — Gestão Financeira
  financeiroFinanciamentos                  String?
  financeiroPoliticaHedge                   String?
  financeiroPosicaoComercializadaSafraAtual String?

  // Bloco 6 — Outras Atividades / Empresas Coligadas (campo pré-existente, só re-rotulado na UI)
  empresasColigadas String?

  // Bloco 7 — Missão, Visão e Valores
  missao  String?
  visao   String?
  valores String?

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("perfil_grupo_economico")
}

// ============================================================
// Fornecedores
// ============================================================

enum Category {
  FERTILIZANTES
  DEFENSIVOS
  SEMENTES
  MAQUINARIOS   @map("MAQUINÁRIOS")
  COMBUSTIVEL   @map("COMBUSTÍVEL")
  SERVICOS      @map("SERVIÇOS")
  OUTROS
}

enum Currency {
  BRL
  USD
}

enum SupplierStatus {
  PENDENTE
  PAGO
  VENCIDO
}

// Formulário "Cadastrar Fornecedor" fotografado pelo usuário em 05/08/2026 — réplica
// confirmada; substitui os campos cnpj_cpf/contato_nome/contato_telefone/contato_email da
// doc de engenharia reversa ("Entidade: FORNECEDOR (estimado)", nunca confirmados por
// print), removidos por não existirem na tela real. `imageUrl` também removido (não
// existe no print) — o "Gerador de Links de Imagem HTML" continua existindo na Sidebar,
// mas como utilitário standalone, sem vínculo com Fornecedor.
model Supplier {
  id             String         @id @default(cuid())
  propriedadeId  String
  nome           String
  categoria      Category
  cultura        String?
  safra          String?
  dividaTotal    Decimal        @db.Decimal(18, 2)
  moeda          Currency
  vencimento     DateTime
  observacoes    String?
  status         SupplierStatus @default(PENDENTE)
  comprovanteUrl String?
  ativo          Boolean        @default(true)

  propriedade Propriedade        @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  compras     CompraFornecedor[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@map("suppliers")
}

model CompraFornecedor {
  id                String   @id @default(cuid())
  supplierId        String
  data              DateTime
  valor             Decimal  @db.Decimal(18, 2)
  descricao         String
  culturaReferencia String?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  createdById String?

  @@index([supplierId])
  @@map("compras_fornecedor")
}

// ============================================================
// Bancos e Financiamentos
// ============================================================

// Tipo de Operação absorve o antigo TipoContratoBancario + FinalidadeContrato — o
// print real do formulário "Cadastrar Contrato Bancário" (fotografado pelo usuário em
// 07/08/2026) só tem um select "Tipo de Operação", sem campo "Finalidade" separado.
// finalidade foi removido do model (tabela estava vazia em produção, sem risco).
enum TipoOperacaoBancaria {
  CUSTEIO_AGRICOLA
  CUSTEIO_PECUARIO
  INVESTIMENTO
  CAPITAL_DE_GIRO
  CPR
  BARTER
  PRONAF
  PRONAMP
  FCO
  FNO
  FINAME
  OUTROS
}

// DOLAR_JUROS é o Cenário "Variação Cambial (VC)" na UI (relabeled em
// 19/08/2026 — chave do enum mantida para não exigir migração de dado).
// Cenário "Dólar Puro" não é um tipoTaxa novo: é moeda=USD + PRE_FIXADO
// (ver ContratoBancario.ptaxInicial e src/lib/taxa-efetiva.ts).
enum TipoTaxaBancaria {
  PRE_FIXADO  @map("PRÉ_FIXADO")
  CDI_SPREAD
  IPCA_SPREAD
  DOLAR_JUROS @map("DÓLAR_JUROS")
}

// BULLET e JUROS_PERIODICOS saíram do enum em 19/08/2026 — o mesmo
// comportamento se obtém via periodicidadePrincipal/periodicidadeJuros =
// FINAL, com SAC ou PRICE. Contratos legados foram migrados na mesma
// migration (ver prisma/migrations/*_sac_price_periodicidade_desacoplada).
enum SistemaAmortizacao {
  SAC
  PRICE
}

// Periodicidade de liquidação, usada separadamente para Principal e Juros.
// FINAL = pagamento único na data de "Vencimento Final" do contrato, sem
// nenhum evento intermediário — substitui o antigo BULLET quando usado nas
// duas pernas. Ver src/lib/amortizacao.ts.
enum PeriodicidadeLiquidacao {
  MENSAL        @map("Mensal")
  BIMESTRAL     @map("Bimestral")
  TRIMESTRAL    @map("Trimestral")
  QUADRIMESTRAL @map("Quadrimestral")
  SEMESTRAL     @map("Semestral")
  ANUAL         @map("Anual")
  FINAL         @map("Final")
}

// Convenção de contagem de dias para converter a taxa anual em taxa do período —
// "252 dias úteis" é aproximado a partir dos dias corridos do período (sem calendário
// de feriados real), documentado em src/lib/amortizacao.ts.
enum BaseCalculoJuros {
  DIAS_UTEIS_252    @map("252_DIAS_UTEIS")
  DIAS_CORRIDOS_360 @map("360_DIAS_CORRIDOS")
  DIAS_CORRIDOS_365 @map("365_DIAS_CORRIDOS")
}

enum TipoCapitalizacao {
  SIMPLES
  COMPOSTA
}

model ContratoBancario {
  id                     String                  @id @default(cuid())
  propriedadeId          String
  banco                  String
  nomeTomador            String?
  numeroContrato         String?
  tipoOperacao           TipoOperacaoBancaria
  safraVinculadaId       String?
  culturaVinculadaId     String?
  saldoInicial           Decimal                 @db.Decimal(18, 2) // "Valor Contratado" no print
  saldoAtual             Decimal                 @db.Decimal(18, 2)
  // Taxa cheia quando tipoTaxa = PRE_FIXADO; spread sobre o indexador nos demais
  // casos. Não existe campo de spread separado — ver src/lib/taxa-efetiva.ts.
  taxaJuros              Decimal                 @db.Decimal(8, 4) // % a.a.
  tipoTaxa               TipoTaxaBancaria
  baseCalculo            BaseCalculoJuros        @default(DIAS_CORRIDOS_360)
  capitalizacao          TipoCapitalizacao       @default(COMPOSTA)
  sistemaAmortizacao     SistemaAmortizacao
  periodicidadePrincipal PeriodicidadeLiquidacao
  periodicidadeJuros     PeriodicidadeLiquidacao
  possuiCarencia         Boolean                 @default(false)
  dataContratacao        DateTime
  inicioPagamento        DateTime?
  dataVencimento         DateTime
  tipoGarantia           String?
  valorGarantia          Decimal?                @db.Decimal(18, 2)
  moeda                  Currency
  // Cenário USD Puro (moeda=USD) e Cenário VC (tipoTaxa=DOLAR_JUROS): cotação
  // R$/US$ na data de contratação — referência pra medir variação cambial.
  // Renovado a cada aniversário do contrato só para fins de CONVERSÃO/exibição
  // (o saldo em USD não é re-marcado) — ver src/lib/taxa-efetiva.ts.
  ptaxInicial            Decimal?                @db.Decimal(10, 4)
  observacoes            String?
  ativo                  Boolean                 @default(true)

  // Memória de cálculo do último cronograma gerado — sem isso não há como saber
  // de que indexador saiu a projeção nem se ela está defasada. Preenchidos por
  // regerarCronograma() (src/server/contratos-bancarios.ts) a cada save e a cada
  // "Atualizar Índices".
  taxaEfetivaAplicada Decimal?  @db.Decimal(8, 4) // % a.a. efetivamente usada
  indiceReferencia    Decimal?  @db.Decimal(10, 4) // valor do CDI/IPCA/USD aplicado
  indiceAtualizadoEm  DateTime?

  propriedade      Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  safraVinculada   Safra?      @relation(fields: [safraVinculadaId], references: [id], onDelete: SetNull)
  culturaVinculada Cultura?    @relation(fields: [culturaVinculadaId], references: [id], onDelete: SetNull)
  parcelas         Parcela[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@index([safraVinculadaId])
  @@index([culturaVinculadaId])
  @@map("contratos_bancarios")
}

// Cronograma auto-gerado (src/lib/amortizacao.ts) a cada criação/edição do
// contrato — regra da engenharia reversa do AgroFlow. Sem UI de baixa de
// parcela ainda (sem spec), então é recriado do zero a cada save.
model Parcela {
  id             String   @id @default(cuid())
  contratoId     String
  numero         Int
  dataPagamento  DateTime
  valorPrincipal Decimal  @db.Decimal(18, 2)
  valorJuros     Decimal  @db.Decimal(18, 2)
  valorTotal     Decimal  @db.Decimal(18, 2)
  saldoDevedor   Decimal  @db.Decimal(18, 2) // saldo após o pagamento desta parcela
  pago           Boolean  @default(false)

  contrato ContratoBancario @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, numero])
  @@index([contratoId])
  @@map("parcelas")
}

// ============================================================
// Aquisição de Fazendas
// ============================================================

// Réplica confirmada da tela "Aquisição de Fazendas" do AgroFlow — spec
// fotografada em 21/07/2026 (docs/demandas/SPEC_TELA_AQUISICAO_FAZENDA.md,
// dataset "Fazenda Pedra"). O modelo raso anterior (só totais agregados, sem
// parcela) foi substituído: agora `ParcelaAquisicao` guarda o detalhamento
// linha a linha (Entrada + Parcelas) que a spec documenta nas abas
// "Contratos" e "Fluxo por Safra", gerado por src/server/aquisicao-engine.ts
// a cada save — mesmo critério do cronograma de `ContratoBancario`.
model Aquisicao {
  id                      String                 @id @default(cuid())
  propriedadeId           String
  nomeFazenda             String
  vendedor                String?
  denominacaoImovel       String?
  comarca                 String?
  numeroMatricula         String?
  estado                  String // UF
  municipio               String
  areaTotalHa             Float
  areaAgricolaHa          Float
  dataAquisicao           DateTime
  dataInicioPagamento     DateTime
  dataVencimento          DateTime
  // Sugerido automaticamente no client a partir do intervalo entre as duas
  // datas acima, mas continua editável e é o que fica persistido (corrige o
  // BUG #2 da spec: no AgroFlow original o campo nunca era pré-preenchido).
  prazoFinanciamentoMeses Int?
  tipoPagamento           TipoPagamentoAquisicao
  // Só "Anual" confirmado pelo print do formulário — texto livre, mesmo
  // critério de Garantias/CAPEX para enum sem lista fechada confirmada.
  periodicidade           String                 @default("Anual")

  // Modo SACAS
  culturaReferenciaId String?
  sacasHa             Decimal? @db.Decimal(12, 4)
  precoReferencia     Decimal? @db.Decimal(18, 4) // R$/sc

  // Modo REAIS
  precoHa          Decimal? @db.Decimal(18, 4)
  valorTotalManual Decimal? @db.Decimal(18, 2)
  valorFinanciado  Decimal? @db.Decimal(18, 2)
  taxaJurosAA      Decimal? @db.Decimal(8, 4) // % a.a.

  // Entrada (Sinal)
  valorEntrada Decimal? @db.Decimal(18, 2)
  safraEntrada String? // "2027/2028"

  // Derivados — soma das ParcelaAquisicao geradas, nunca calculado ad-hoc na UI
  valorTotalFluxo Decimal @db.Decimal(18, 2)
  totalSacas      Float

  ativo Boolean @default(true)

  propriedade       Propriedade        @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  culturaReferencia Cultura?           @relation(fields: [culturaReferenciaId], references: [id], onDelete: SetNull)
  parcelas          ParcelaAquisicao[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@index([culturaReferenciaId])
  @@map("aquisicoes")
}

// Gerada do zero a cada save de Aquisicao (delete + createMany), mesmo
// critério de `Parcela`/`ContratoBancario` — sem UI de baixa de parcela.
model ParcelaAquisicao {
  id                 String                  @id @default(cuid())
  aquisicaoId        String
  safra              String // "2026/2027"
  tipo               TipoLancamentoAquisicao
  sacas              Decimal                 @default(0) @db.Decimal(14, 2)
  precoSc            Decimal?                @db.Decimal(18, 4)
  usaPrecoReferencia Boolean                 @default(false)
  valorTotal         Decimal                 @db.Decimal(18, 2)
  dataPagamento      DateTime
  ordem              Int

  aquisicao Aquisicao @relation(fields: [aquisicaoId], references: [id], onDelete: Cascade)

  @@index([aquisicaoId])
  @@map("parcelas_aquisicao")
}

enum TipoPagamentoAquisicao {
  SACAS
  REAIS
}

enum TipoLancamentoAquisicao {
  ENTRADA
  PARCELA
}

// ============================================================
// Arrendamentos
// ============================================================

// Réplica confirmada da tela "Arrendamento Rural" do AgroFlow — spec
// fotografada em 21/07/2026 (docs/demandas/SPEC_TELA_ARRENDAMENTO_RURAL.md,
// dataset "Grupo Pereira" com os contratos "Fazenda Matagal"/"Fazenda Pedra
// II"). Reconstruído em 20/08/2026 no mesmo padrão de `Aquisicao`
// (`ParcelaArrendamento` guarda o detalhamento por safra, gerado por
// src/lib/arrendamento-engine.ts a cada save) — o modelo raso anterior (só
// `areaHectares × custoAnualHectare`, sem safra/preço) não sobrevivia ao BUG
// #1 da spec (contrato sem "Preço de Referência" quebrando o cálculo em
// cascata) porque não tinha o conceito de preço de referência para começo de
// conversa. `contratos_arrendamento` estava vazia em produção (0 registros)
// no momento da reconstrução — sem dado real a migrar.

enum PeriodicidadeArrendamento {
  ANUAL     @map("Anual")
  MENSAL    @map("Mensal")
  POR_SAFRA @map("Por Safra")
}

enum StatusArrendamento {
  ATIVO
  ENCERRADO
}

// null = sem preço disponível (N/D em toda a UI, nunca "R$ 0" — corrige o
// BUG #2 da spec).
enum OrigemPrecoArrendamento {
  CONTRATO // "Preço de Referência" preenchido no próprio contrato
  COTACAO  // Fallback: Cotacao.precoDefinidoSafra da commodity correspondente à cultura
}

model ContratoArrendamento {
  id            String @id @default(cuid())
  propriedadeId String

  // 1. Identificação — só nomeFazenda e areaArrendadaHa são obrigatórios, igual
  // à tela real (seção 4.1 da spec: só "Nome da Fazenda/Área*" tem asterisco).
  // Não existe CPF/CNPJ do proprietário na tela real — era um campo "estimado"
  // da engenharia reversa nunca confirmado, mesmo critério já aplicado em
  // Fornecedores (05/08/2026).
  nomeFazenda       String
  proprietario      String?
  denominacaoImovel String?
  municipio         String?
  comarca           String?
  numeroMatricula   String?

  // 2. Área
  areaTotalHa     Float?
  areaArrendadaHa Float

  // 3. Contrato — safra inicial/final são CALCULADAS a partir das datas
  // (src/lib/safra-periodo.ts) em vez de texto livre digitado à mão.
  dataInicio     DateTime
  dataVencimento DateTime

  // 4. Condições Econômicas e Pagamento
  culturaReferenciaId String?
  tipoPagamento       TipoPagamentoAquisicao   @default(SACAS)
  periodicidade       PeriodicidadeArrendamento @default(ANUAL)
  sacasHa             Decimal?                 @db.Decimal(12, 4) // modo SACAS
  precoReferencia     Decimal?                 @db.Decimal(18, 4) // modo SACAS — opcional (raiz do BUG #1; coberto por fallback de Cotações)
  precoHa             Decimal?                 @db.Decimal(18, 4) // modo REAIS
  valorTotalManual    Decimal?                 @db.Decimal(18, 2) // modo REAIS

  // 5. Pagamento Antecipado
  possuiPagamentoAntecipado  Boolean   @default(false)
  valorAntecipado            Decimal?  @db.Decimal(14, 2) // sacas (modo SACAS) ou R$ (modo REAIS)
  dataPagamentoAntecipado    DateTime?
  safraReferenciaAntecipacao String?

  observacoes String?
  status      StatusArrendamento @default(ATIVO)
  ativo       Boolean            @default(true)

  // Derivados — soma das ParcelaArrendamento geradas, nunca calculado ad-hoc na UI
  valorTotalFluxo Decimal @db.Decimal(18, 2)
  totalSacas      Float

  propriedade       Propriedade           @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  culturaReferencia Cultura?              @relation(fields: [culturaReferenciaId], references: [id], onDelete: SetNull)
  parcelas          ParcelaArrendamento[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@index([culturaReferenciaId])
  @@map("contratos_arrendamento")
}

// Gerada do zero a cada save de ContratoArrendamento (delete + createMany),
// mesmo critério de ParcelaAquisicao/Parcela. Uma linha por safra — diferente
// de ParcelaAquisicao (duas linhas tipadas ENTRADA/PARCELA): a spec de
// Arrendamento mostra Sacas Brutas/(-) Antecipado/Sacas Líquidas na MESMA
// linha da tabela "Fluxo de Pagamento por Safra".
model ParcelaArrendamento {
  id               String                   @id @default(cuid())
  contratoId       String
  safra            String // "2026/2027"
  sacasBrutas      Decimal                  @default(0) @db.Decimal(14, 2)
  sacasAntecipadas Decimal                  @default(0) @db.Decimal(14, 2)
  sacasLiquidas    Decimal                  @default(0) @db.Decimal(14, 2)
  precoSc          Decimal?                 @db.Decimal(18, 4)
  origemPreco      OrigemPrecoArrendamento?
  valorTotal       Decimal?                 @db.Decimal(18, 2) // null quando origemPreco é null
  ordem            Int

  contrato ContratoArrendamento @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId])
  @@map("parcelas_arrendamento")
}

// ============================================================
// Comercialização (Futuros/Hedge)
// ============================================================

enum TipoContratoComercial {
  FUTURO
  VENDA_A_TERMO
  HEDGE_CALL
  HEDGE_PUT
}

enum StatusContratoComercial {
  ATIVO
  LIQUIDADO
  CANCELADO
}

model ContratoComercial {
  id             String                  @id @default(cuid())
  propriedadeId  String
  cultura        String
  safra          String
  quantidadeSc   Float
  precoFixado    Decimal                 @db.Decimal(18, 2)
  tipoContrato   TipoContratoComercial
  dataContrato   DateTime
  dataVencimento DateTime
  status         StatusContratoComercial @default(ATIVO)
  compradorNome  String?
  // R$/USD no momento da contratação — só relevante pra contratos em dólar
  // (CBOT/NDF). Data em que o pagamento é esperado — registrada aqui, mas
  // NÃO integrada ao Fluxo de Caixa nesta fase (mesmo critério já aplicado a
  // Aquisição/Arrendamento: Fluxo Mensal/Fluxo de Safra são só projeção do
  // Quadro de Safra, nenhum contrato lança lá ainda).
  cambioUsd                Decimal?  @db.Decimal(10, 4)
  dataLiquidacaoFinanceira DateTime?
  observacoes    String?
  ativo          Boolean                 @default(true)

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([propriedadeId, ativo])
  @@map("contratos_comerciais")
}

// ============================================================
// Análise Financeira — Balanço consolidado do grupo (Conta)
// ============================================================

// Indicadores são SEMPRE computados ao vivo a partir destes 6 campos
// (src/lib/indicadores.ts) — nunca persistidos como número solto. Indicadores
// que exigiriam contas mais finas (caixa, estoques, EBITDA...) não existentes
// aqui ficam explicitamente "dados insuficientes" na UI, nunca inventados.
model BalancoPatrimonial {
  id                   String  @id @default(cuid())
  contaId              String
  safra                String // "2026/2027"
  ativoCirculante      Decimal @db.Decimal(18, 2)
  ativoNaoCirculante   Decimal @db.Decimal(18, 2)
  passivoCirculante    Decimal @db.Decimal(18, 2)
  passivoNaoCirculante Decimal @db.Decimal(18, 2)
  capitalReservas      Decimal @db.Decimal(18, 2)
  resultadoSafra       Decimal @db.Decimal(18, 2)
  ativo                Boolean @default(true)

  conta Conta @relation(fields: [contaId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@unique([contaId, safra])
  @@index([contaId, ativo])
  @@map("balancos_patrimoniais")
}

// ============================================================
// Cotações de Mercado — dado global, sem tenant (mesmo preço pra todo mundo).
// Ingestão real: AwesomeAPI (câmbio) + Yahoo Finance (futuros de commodities),
// ambas sem chave — ver src/lib/market-data.ts.
// ============================================================

enum Bolsa {
  CBOT
  CME
  ICE
  B3
  PTAX
}

model Cotacao {
  id                 String   @id @default(cuid())
  commodity          String   @unique
  bolsa              Bolsa
  ticker             String
  precoUsd           Decimal? @db.Decimal(18, 4)
  precoBrl           Decimal  @db.Decimal(18, 4)
  unidade            String
  variacaoPercentual Decimal  @db.Decimal(8, 4)
  maxima             Decimal  @db.Decimal(18, 4)
  minima             Decimal  @db.Decimal(18, 4)
  volume             BigInt   @default(0)
  precoDefinidoSafra Decimal? @db.Decimal(18, 4) // preço que o usuário "trava" como referência da safra
  atualizadoEm       DateTime @default(now())

  @@map("cotacoes")
}

// ============================================================
// Índices de Mercado — dado global, sem tenant (o CDI é o mesmo pra todo mundo,
// mesmo critério de Cotacao). Alimentam o cálculo de juros dos contratos
// bancários indexados (src/lib/taxa-efetiva.ts).
//
// Fontes, todas públicas e sem chave (src/lib/market-data.ts):
//  - CDI:  BCB SGS 4389  (CDI anualizado base 252, % a.a.) — REALIZADO
//  - IPCA: BCB SGS 13522 (IPCA acumulado em 12 meses, %) — REALIZADO
//  - USD:  AwesomeAPI USD-BRL (mesma fonte já usada pelas cotações) — REALIZADO
//  - Projeções (PROJETADO): API de Expectativas de Mercado (Focus) do BACEN,
//    indicadores 'Selic' (proxy de CDI — não existe indicador CDI na Focus),
//    'IPCA' e 'Câmbio', um ponto por ano-calendário.
//
// Série temporal (19/08/2026) — deixou de ser snapshot único (1 linha por
// tipo, sempre sobrescrita) pra guardar 1 linha por (tipo, origem,
// dataReferencia), nunca sobrescrita. Isso permite reconstituir "qual era o
// realizado/a projeção em cada data", pré-requisito pra aplicar o índice
// correto por período no cronograma (ver src/server/cronograma-engine.ts) —
// realizado nas parcelas já vencidas, projeção nas parcelas futuras.
// `dataReferencia`: pra REALIZADO, a data do dado na fonte; pra PROJETADO, o
// ano-calendário alvo da projeção (1º de janeiro daquele ano).
// ============================================================

enum TipoIndice {
  CDI
  IPCA
  USD
}

enum OrigemIndice {
  REALIZADO
  PROJETADO
}

model IndiceMercado {
  id             String       @id @default(cuid())
  tipo           TipoIndice
  origem         OrigemIndice @default(REALIZADO)
  valor          Decimal      @db.Decimal(10, 4) // CDI/IPCA: % a.a. | USD: BRL por USD
  unidade        String // "% a.a." | "BRL/USD"
  fonte          String // "BCB SGS 4389" | "AwesomeAPI USD-BRL" | "BCB Focus (Selic)"
  dataReferencia DateTime // ver nota acima — significado difere por origem
  atualizadoEm   DateTime     @default(now())

  @@unique([tipo, origem, dataReferencia])
  @@index([tipo, origem])
  @@map("indices_mercado")
}
