# DATABASE_URL: connection string do Postgres.
# Necessária para `npm run dev`, `npm run db:migrate` e `npm run db:seed`.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# BETTER_AUTH_SECRET: chave usada para assinar sessões e cookies.
# Gere uma com `openssl rand -base64 32` — nunca reutilize entre ambientes.
BETTER_AUTH_SECRET="troque-por-um-valor-aleatorio-de-32-bytes"

# BETTER_AUTH_URL: origem pública do app (sem barra final).
BETTER_AUTH_URL="http://localhost:3000"

# Credenciais do Admin Master (superadmin), criado por `npm run db:seed`.
# Definir só localmente / nas env vars do ambiente — nunca commitar.
SUPERADMIN_EMAIL="admin@agrogestao.com.br"
SUPERADMIN_PASSWORD="troque-por-uma-senha-forte"
